{
  "name": "audhdities",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "vercel-build": "npm run cosmic:generate && next build",
    "postinstall": "echo '🛠️ AudHDities Sanctuary - The Loom Awaits'",
    "generate:enums": "tsx src/scripts/system/gaia.ts",
    "generate:enums:verbose": "tsx src/scripts/system/gaia/generate_enums_file.ts --verbose",    
    "generate:indexes": "tsx src/scripts/modules/generate/index_files.ts",
    "generate:indexes:verbose": "tsx src/scripts/modules/generate/index_files.ts --verbose",
    "generate:all": "npm run generate:validators && npm run generate:types && npm run generate:indexes",
    "cosmic:generate": "tsx src/scripts/system/cosmic/index.ts",
    "cosmic:dry": "tsx src/scripts/system/cosmic/index.ts --dry-run",
    "cosmic:watch": "tsx src/scripts/system/cosmic/index.ts --watch",
    "gaia:generate": "tsx src/scripts/system/gaia/index.ts",
    "gaia:dry": "tsx src/scripts/system/gaia/index.ts --dry-run",
    "gaia:force": "tsx src/scripts/system/gaia/index.ts --force",
    "mnemosyne:run": "tsx src/scripts/system/mnemosyne/index.ts",
    "prometheus:run": "tsx src/scripts/system/prometheus/index.ts",
    "maintenance:check": "tsx src/scripts/modules/agentic_maintenance.ts --check",
    "maintenance:run": "tsx src/scripts/modules/agentic_maintenance.ts --run",
    "analyze:deps": "tsx src/scripts/modules/analyze/analyze_dependencies.ts",
    "clean": "rm -rf .next node_modules/.cache src/styles/generated tailwind.generated.config.mjs",
    "clean:generated": "rm -rf src/styles/generated tailwind.generated.config.mjs"
  },
  "dependencies": {
