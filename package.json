    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.548.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "19.2.0",
    "react-countup": "^6.5.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.0",
