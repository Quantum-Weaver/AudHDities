# ─── SOVEREIGNTY — NEVER COMMIT ───────────────────────────
# (merged from resonance-standards/git/.gitignore-template, 2026-07-13)
*.keystore
*.jks
*.apk
*.aab
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
*.pem
*.key
secrets.yaml
secrets.yml
*.db
*.sqlite

# ─── DEPENDENCIES ──────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── BUILD OUTPUT ──────────────────────────────────────────
/.next/
.next/dev
/out/
/build
dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# ─── TESTING / SCRATCH ─────────────────────────────────────
/coverage
phoenix
.temp
.temp*

# ─── DEBUG ─────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ───────────────────────────────────────────────────
.vscode/settings.json
.idea/
