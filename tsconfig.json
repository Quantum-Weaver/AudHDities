{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, "src/components/admin/files/FileDependencies.tsx,md", ".temp/helpers/archive/extract_functions.ts", "src/scripts/system/gaia/extract_runtime_enums.ts", ".temp/helpers/archive/extract_tables.ts", ".temp/helpers/archive/extract_type_enums.ts", ".temp/helpers/archive/extract_views.ts"  ],
  "exclude": [
    "node_modules",
    "**/staging/**",
    "**/archive/**",
    "**/.next/**"
  ]
}
